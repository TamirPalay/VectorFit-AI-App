# Copy to backend/.env for local dev. In production these are set in the
# Render dashboard (see render.yaml), not committed.

# ── LLM Provider ───────────────────────────────────────────────────────────────
# "gemini" (used in production), "groq" (fallback), or "ollama" (local, no cost)
LLM_PROVIDER=gemini

# Gemini — native google-genai SDK. Enable billing on the key for live demos:
# the free tier's 5 req/min cap will 429 the daily-program narration.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Groq (https://console.groq.com) — kept as a fallback provider
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (local — run `ollama serve` and pull a model first)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite for local dev. On Render's free tier the disk is ephemeral, so the DB
# is re-seeded on boot when empty (SEED_ON_STARTUP below).
DATABASE_URL=sqlite:///./vectorfit.db

# ── App ────────────────────────────────────────────────────────────────────────
# CORS allow-list. Single URL or comma-separated. Set to your Vercel URL in prod.
# (*.vercel.app preview deploys are always allowed via regex.)
FRONTEND_ORIGIN=http://localhost:5173

# Seed the 3 demo users on startup if the database is empty. Safe to leave on —
# the seeder is idempotent. Set to "false" to disable.
SEED_ON_STARTUP=true

# Secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_me_to_a_random_secret
