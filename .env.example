# ── LLM Provider ───────────────────────────────────────────────────────────────
# Set to "groq" for production/cloud use, "ollama" for local dev (no API cost)
LLM_PROVIDER=groq

# Groq (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (local — run `ollama serve` and pull a model first)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite for local dev. For Render deployment, use an absolute path or Turso URL.
DATABASE_URL=sqlite:///./vectorfit.db

# ── App ────────────────────────────────────────────────────────────────────────
# Frontend origin for CORS (update to your Vercel URL in production)
FRONTEND_ORIGIN=http://localhost:5173

# Secret key for signing tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_me_to_a_random_secret
